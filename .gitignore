# Dependencies (re-created by `npm install`)
node_modules/

# Build output (re-created by `npm run build`)
dist/
dist-ssr/

# Secrets and local settings. Never upload these.
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cloudflare / Netlify / Vercel local folders
.wrangler/
.netlify/
.vercel/

# NOTE: public/images/ is NOT ignored on purpose, so your photos are uploaded with the site.
